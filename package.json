{
  "private": true,
  "main": "dist/main.electron.js",
  "scripts": {
    "start": "vite --host",
    "build": "tsc --noEmit && vite build --mode development",
    "build:prod": "vite build",
    "test": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "serve": "vite preview --port 5000 --host",
    "clean": "rimraf dist",
    "build:electron-files": "node scripts/build-electron.js",
    "electron": "npm run build:electron-files && electron .",
    "electron:dev": "npm run build && npm run build:electron-files && electron .",
    "electron:pack": "npm run build:prod && npm run build:electron-files && electron-builder",
    "dev": "concurrently \"npm run start\" \"wait-on http://localhost:5000 && npm run build:electron-files && electron .\"",
    "build:electron": "npm run build:prod && npm run build:electron-files && electron-builder --publish=never"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^24.0.13",
    "concurrently": "^9.2.0",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "optionalDependencies": {
    "fsevents": "*"
  }
}
